# ============================================================================
# Dockerfile.python — API de Fornecedores (src/fornecedores_api.py)
# ----------------------------------------------------------------------------
# Uso normal: `docker compose up --build`.
# Isolado:    docker build -f Dockerfile.python -t labsystem-fornecedores .
# ============================================================================
FROM python:3.10-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1
RUN addgroup --system app && adduser --system --ingroup app app
COPY requirements.txt ./
# Instala as dependências e depois remove as ferramentas de empacotamento
# (pip/setuptools/wheel e as cópias em ensurepip): o runtime não precisa
# delas, e elas carregam CVEs HIGH que o Trivy acusaria.
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y setuptools wheel \
    && python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.10/ensurepip
COPY src/fornecedores_api.py ./src/fornecedores_api.py
USER app
EXPOSE 3001
CMD ["python", "src/fornecedores_api.py"]

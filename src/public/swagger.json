{
  "openapi": "3.0.0",
  "info": {
    "title": "LabSystem API",
    "version": "2.0.0",
    "description": "API REST do LabSystem — Usuários e Clientes com autenticação por sessão."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "paths": {

    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autenticar usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado — cookie sessao_id definido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioSessao" } } } },
          "400": { "description": "E-mail ou senha não informados" },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },

    "/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Encerrar sessão",
        "responses": {
          "200": { "description": "Sessão encerrada" }
        }
      }
    },

    "/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Retornar usuário da sessão atual",
        "responses": {
          "200": { "description": "Usuário autenticado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioSessao" } } } },
          "401": { "description": "Não autenticado" }
        }
      }
    },

    "/usuarios": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Listar todos os usuários",
        "description": "Requer sessão com role **Admin**.",
        "responses": {
          "200": { "description": "Lista de usuários", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Usuario" } } } } },
          "401": { "description": "Não autenticado" },
          "403": { "description": "Acesso restrito a administradores" }
        }
      },
      "post": {
        "tags": ["Usuários"],
        "summary": "Criar usuário",
        "description": "Requer sessão com role **Admin**.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioInput" } } }
        },
        "responses": {
          "201": { "description": "Usuário criado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } } },
          "400": { "description": "Campos obrigatórios ausentes" },
          "401": { "description": "Não autenticado" },
          "403": { "description": "Acesso restrito a administradores" }
        }
      }
    },

    "/usuarios/{id}": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Buscar usuário por ID",
        "description": "Requer sessão com role **Admin**.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Usuário encontrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } } },
          "401": { "description": "Não autenticado" },
          "403": { "description": "Acesso restrito" },
          "404": { "description": "Usuário não encontrado" }
        }
      },
      "put": {
        "tags": ["Usuários"],
        "summary": "Atualizar usuário",
        "description": "Requer sessão com role **Admin**. Deixar `senha` em branco para não alterar.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioInput" } } }
        },
        "responses": {
          "200": { "description": "Usuário atualizado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } } },
          "401": { "description": "Não autenticado" },
          "403": { "description": "Acesso restrito" },
          "404": { "description": "Usuário não encontrado" }
        }
      },
      "delete": {
        "tags": ["Usuários"],
        "summary": "Deletar usuário",
        "description": "Requer sessão com role **Admin**. Usuário id=1 não pode ser removido.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Usuário removido" },
          "400": { "description": "Não é possível remover o administrador principal" },
          "401": { "description": "Não autenticado" },
          "403": { "description": "Acesso restrito" },
          "404": { "description": "Usuário não encontrado" }
        }
      }
    },

    "/clientes": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Listar todos os clientes",
        "description": "Requer sessão autenticada.",
        "responses": {
          "200": { "description": "Lista de clientes", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Cliente" } } } } },
          "401": { "description": "Não autenticado" }
        }
      },
      "post": {
        "tags": ["Clientes"],
        "summary": "Criar cliente",
        "description": "Requer sessão autenticada.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClienteInput" } } }
        },
        "responses": {
          "201": { "description": "Cliente criado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cliente" } } } },
          "400": { "description": "Nome é obrigatório" },
          "401": { "description": "Não autenticado" }
        }
      }
    },

    "/clientes/{id}": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Buscar cliente por ID",
        "description": "Requer sessão autenticada.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Cliente encontrado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cliente" } } } },
          "401": { "description": "Não autenticado" },
          "404": { "description": "Cliente não encontrado" }
        }
      },
      "put": {
        "tags": ["Clientes"],
        "summary": "Atualizar cliente",
        "description": "Requer sessão autenticada.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClienteInput" } } }
        },
        "responses": {
          "200": { "description": "Cliente atualizado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cliente" } } } },
          "401": { "description": "Não autenticado" },
          "404": { "description": "Cliente não encontrado" }
        }
      },
      "delete": {
        "tags": ["Clientes"],
        "summary": "Deletar cliente",
        "description": "Requer sessão autenticada.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Cliente removido" },
          "401": { "description": "Não autenticado" },
          "404": { "description": "Cliente não encontrado" }
        }
      }
    }

  },
  "components": {
    "schemas": {

      "LoginInput": {
        "type": "object",
        "required": ["email", "senha"],
        "properties": {
          "email": { "type": "string", "example": "Alexaugusto2@gmail.com" },
          "senha": { "type": "string", "example": "admin123" }
        }
      },

      "UsuarioSessao": {
        "type": "object",
        "properties": {
          "id":   { "type": "integer", "example": 1 },
          "nome": { "type": "string",  "example": "Alexander" },
          "role": { "type": "string",  "example": "Admin" }
        }
      },

      "Usuario": {
        "type": "object",
        "properties": {
          "id":    { "type": "integer", "example": 1 },
          "nome":  { "type": "string",  "example": "Alexander" },
          "email": { "type": "string",  "example": "Alexaugusto2@gmail.com" },
          "role":  { "type": "string",  "example": "Admin", "enum": ["Admin", "Atendente", "Visitante"] }
        }
      },

      "UsuarioInput": {
        "type": "object",
        "properties": {
          "nome":  { "type": "string", "example": "Maria Silva" },
          "email": { "type": "string", "example": "maria@email.com" },
          "senha": { "type": "string", "example": "senha123" },
          "role":  { "type": "string", "example": "Atendente", "enum": ["Admin", "Atendente", "Visitante"] }
        }
      },

      "Cliente": {
        "type": "object",
        "properties": {
          "id":       { "type": "integer", "example": 1 },
          "nome":     { "type": "string",  "example": "João da Silva" },
          "endereco": { "type": "string",  "example": "Rua das Flores, 123" },
          "bairro":   { "type": "string",  "example": "Centro" },
          "cidade":   { "type": "string",  "example": "São Paulo" },
          "estado":   { "type": "string",  "example": "SP" },
          "email":    { "type": "string",  "example": "joao@email.com" },
          "telefone": { "type": "string",  "example": "(11) 98765-4321" }
        }
      },

      "ClienteInput": {
        "type": "object",
        "required": ["nome"],
        "properties": {
          "nome":     { "type": "string", "example": "João da Silva" },
          "endereco": { "type": "string", "example": "Rua das Flores, 123" },
          "bairro":   { "type": "string", "example": "Centro" },
          "cidade":   { "type": "string", "example": "São Paulo" },
          "estado":   { "type": "string", "example": "SP" },
          "email":    { "type": "string", "example": "joao@email.com" },
          "telefone": { "type": "string", "example": "(11) 98765-4321" }
        }
      }

    }
  }
}
